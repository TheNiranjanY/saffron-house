# MySQL 8 — operational database
MYSQL_ROOT_PASSWORD=saffron_root
MYSQL_DATABASE=restaurant
MYSQL_USER=restaurant
MYSQL_PASSWORD=restaurantpass
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307

# TimescaleDB — time-series analytics database
TS_DATABASE=restaurant_analytics
TS_USER=restaurant
TS_PASSWORD=restaurantpass
TS_HOST=127.0.0.1
TS_PORT=5433

# Application
TZ=Asia/Kolkata
FLASK_PORT=5001
FLASK_DEBUG=1
SQL_LAB_ENABLED=1

# Hosted deployment only — leave unset for local Docker
# MYSQL_SSL_CA=/path/to/ca.pem
# TS_SSLMODE=require
# TS_SSLROOTCERT=/path/to/ca.pem
# MYSQL_POOL_SIZE=5
# TS_POOL_MAX=3
# CORS_ORIGINS=https://your-app.vercel.app
